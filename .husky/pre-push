# Require a version bump + changelog entry before pushing to main.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && continue

  git fetch origin main --quiet 2>/dev/null || true

  # Skip the version/changelog check if only hooks or tests changed.
  changed_files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)
  app_code_changed=0
  for f in $changed_files; do
    case "$f" in
      .husky/*|*.test.ts|*.test.tsx) ;;
      *) app_code_changed=1 ;;
    esac
  done
  [ "$app_code_changed" -eq 0 ] && continue

  old_version=$(git show "$remote_sha:package.json" 2>/dev/null | grep -m1 '"version"' | sed -E 's/.*"version": *"([^"]*)".*/\1/')
  new_version=$(grep -m1 '"version"' package.json | sed -E 's/.*"version": *"([^"]*)".*/\1/')

  changelog_changed=0
  git diff --quiet "$remote_sha" -- src/changelog.ts 2>/dev/null || changelog_changed=1

  if [ "$old_version" = "$new_version" ] || [ "$changelog_changed" -eq 0 ]; then
    echo "Push to main blocked: bump the version in package.json and add an entry to src/changelog.ts before pushing."
    exit 1
  fi
done

npm test
